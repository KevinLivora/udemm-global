generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Universidad {
  id         String     @id @default(uuid())
  nombre     String
  creadoEn   DateTime   @default(now())
  facultades Facultad[]
}

model Facultad {
  id                 String               @id @default(uuid())
  nombre             String
  universidadId      String
  codigo             String?              @unique
  descripcion        String?
  estado             String               @default("ACTIVO")
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  carreras           Carrera[]
  universidad        Universidad          @relation(fields: [universidadId], references: [id])
  vinculaciones      VinculacionCatedra[]
  usuariosAsociados  UsuarioFacultad[]
}

model Carrera {
  id                 String               @id @default(uuid())
  nombre             String
  facultadId         String
  codigo             String?              @unique
  tituloOtorgado     String?
  duracionAnios      Int?
  modalidad          String?
  estado             String               @default("ACTIVO")
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  facultad           Facultad             @relation(fields: [facultadId], references: [id])
  planes             PlanEstudio[]
  vinculaciones      VinculacionCatedra[]
  usuariosAsociados  UsuarioCarrera[]
}

model PlanEstudio {
  id                    String               @id @default(uuid())
  nombre                String
  carreraId             String
  codigo                String?              @unique
  descripcion           String?
  duracionCuatrimestres Int?
  estado                String               @default("ACTIVO")
  fechaActualizacion    DateTime             @updatedAt
  fechaAprobacion       DateTime?
  fechaCreacion         DateTime             @default(now())
  resolucionAprobacion  String?
  totalCreditos         Int?
  version               String?
  anio                  Int?
  materias              Materia[]
  carrera               Carrera              @relation(fields: [carreraId], references: [id])
  vinculaciones         VinculacionCatedra[]
}

model Materia {
  id                  String               @id @default(uuid())
  codigo              String               @unique
  nombre              String
  creditos            Int                  @default(0)
  planEstudioId       String
  anio                Int?
  cuatrimestre        Int?
  descripcion         String?
  estado              String               @default("ACTIVO")
  fechaActualizacion  DateTime             @updatedAt
  fechaCreacion       DateTime             @default(now())
  bloqueConocimiento  String?
  cargaHorariaSemanal Int?
  cargaHorariaTotal   Int?
  observaciones       String?
  regimenCursado      String?
  tipoAsignatura      String               @default("OBLIGATORIA")
  modalidadDictado    String?
  esCorrelativaDe     Correlatividad[]     @relation("MateriaCorrelativa")
  correlativas        Correlatividad[]     @relation("MateriaPrincipal")
  historial           HistorialMateria[]
  planEstudio         PlanEstudio          @relation(fields: [planEstudioId], references: [id])
  programa            ProgramaAsignatura?
  vinculaciones       VinculacionCatedra[]
}

model ProgramaAsignatura {
  id                         String              @id @default(uuid())
  materiaId                  String              @unique
  equipoDocente              String?
  elaboradoPor               String?
  anioVigencia               Int?
  fundamentacion             String?
  objetivosGenerales         String?
  objetivosEspecificos       String?
  contenidosTematicos        String?
  bibliografiaBasica         String?
  bibliografiaComplementaria String?
  recursosDidacticos         String?
  metodologiaEnsenanza       String?
  actividadesPracticas       String?
  cronograma                 String?
  criteriosEvaluacion        String?
  instrumentosEvaluacion     String?
  condicionesAprobacion      String?
  estadoPrograma             String              @default("PENDIENTE")
  fechaAprobacion            DateTime?
  resolucionAprobacion       String?
  observacionesGenerales     String?
  vigenciaDesde              Int?
  vigenciaHasta              Int?
  estadoS1                   String              @default("PENDIENTE")
  estadoS2                   String              @default("PENDIENTE")
  estadoS3                   String              @default("PENDIENTE")
  estadoS4                   String              @default("PENDIENTE")
  estadoS5                   String              @default("PENDIENTE")
  estadoS6                   String              @default("PENDIENTE")
  fechaCreacion              DateTime            @default(now())
  fechaActualizacion         DateTime            @default(now()) @updatedAt
  propositos                 String?
  contenidosSinteticos       String?
  tiposFormacionPractica     String?
  porcentajeTiempoFormacion  String?
  modalidadEvaluacion        String?
  requisitosAprobacion       String?
  fechaVigenciaPrograma      Int?
  anioAprobacionRevision     String?
  profesorACargo             String?
  competenciasVinculadas     String?
  fechaUltimaActualizacion   String?
  observacionesGestion       String?
  aportesPerfilTitulo        String?
  recomendacionesCursado     String?
  competenciasResultadosJson String?
  contenidosGridJson         String?
  unidadesDidacticasJson       String?
  formacionPracticaJson        String?
  actividadesFormacionPractica String?
  historial                    HistorialPrograma[]
  solicitudes                  SolicitudAprobacionPrograma[]
  mensajesCorrecion            MensajeCorrecionPrograma[]
  materia                    Materia             @relation(fields: [materiaId], references: [id], onDelete: Cascade)
}

model HistorialPrograma {
  id          String             @id @default(uuid())
  programaId  String
  accion      String
  seccion     String?
  descripcion String?
  usuarioId   String
  fecha       DateTime           @default(now())
  programa    ProgramaAsignatura @relation(fields: [programaId], references: [id], onDelete: Cascade)
  usuario     Usuario            @relation(fields: [usuarioId], references: [id])
}

model HistorialMateria {
  id          String   @id @default(uuid())
  materiaId   String
  accion      String
  descripcion String?
  usuarioId   String
  fecha       DateTime @default(now())
  materia     Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])
}

model Correlatividad {
  id            String   @id @default(uuid())
  materiaId     String
  correlativaId String
  tipo          String   @default("CURSADO")
  fechaCreacion DateTime @default(now())
  correlativa   Materia  @relation("MateriaCorrelativa", fields: [correlativaId], references: [id])
  materia       Materia  @relation("MateriaPrincipal", fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([materiaId, correlativaId])
}

model Rol {
  id            String       @id @default(uuid())
  nombre        String       @unique
  descripcion   String?
  fechaCreacion DateTime     @default(now())
  activo        Boolean      @default(true)
  permisos      RolPermiso[]
  usuarios      Usuario[]
}

model ParametroGeneral {
  id                 String   @id @default(uuid())
  clave              String   @unique
  valor              String
  descripcion        String?
  fechaActualizacion DateTime @updatedAt
}

model Permiso {
  id            String       @id @default(uuid())
  nombre        String       @unique
  descripcion   String?
  fechaCreacion DateTime     @default(now())
  roles         RolPermiso[]
}

model RolPermiso {
  id            String   @id @default(uuid())
  rolId         String
  permisoId     String
  fechaCreacion DateTime @default(now())
  permiso       Permiso  @relation(fields: [permisoId], references: [id])
  rol           Rol      @relation(fields: [rolId], references: [id])

  @@unique([rolId, permisoId])
}

model Usuario {
  id                         String               @id @default(uuid())
  nombre                     String
  apellido                   String
  correoElectronico          String               @unique
  contrasenaHash             String
  activo                     Boolean              @default(true)
  fechaCreacion              DateTime             @default(now())
  fechaActualizacion         DateTime             @updatedAt
  rolId                      String
  docente                    Docente?
  historialMaterias          HistorialMateria[]
  historialProgramas         HistorialPrograma[]
  sesiones                   Sesion[]
  tokensRecuperacion         TokenRecuperacion[]
  tokensRefresh              TokenRefresh[]
  rol                        Rol                  @relation(fields: [rolId], references: [id])
  vinculacionesAprobadas          VinculacionCatedra[] @relation("VinculacionAprobador")
  vinculacionesDesvinculadas      VinculacionCatedra[] @relation("VinculacionDesvinculador")
  vinculacionesSolicitadas        VinculacionCatedra[] @relation("VinculacionSolicitante")
  carrerasAsociadas               UsuarioCarrera[]
  facultadesAsociadas             UsuarioFacultad[]
  solicitudesProgramasAprobadas   SolicitudAprobacionPrograma[] @relation("SolicitudProgramaAprobador")
  mensajesCorrecion               MensajeCorrecionPrograma[]
  notificaciones                  Notificacion[]
}

model Sesion {
  id                 String         @id @default(uuid())
  usuarioId          String
  ip                 String?
  userAgent          String?
  activo             Boolean        @default(true)
  fechaCreacion      DateTime       @default(now())
  fechaActualizacion DateTime       @updatedAt
  usuario            Usuario        @relation(fields: [usuarioId], references: [id])
  tokensRefresh      TokenRefresh[]
}

model TokenRefresh {
  id            String   @id @default(uuid())
  token         String   @unique
  usuarioId     String
  sesionId      String?
  expiracion    DateTime
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  sesion        Sesion?  @relation(fields: [sesionId], references: [id])
}

model TokenRecuperacion {
  id         String   @id @default(uuid())
  token      String   @unique
  usuarioId  String
  expiracion DateTime
  usado      Boolean  @default(false)
  creadoEn   DateTime @default(now())
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
}

model Catedra {
  id                 String               @id @default(uuid())
  nombre             String               @unique
  activo             Boolean              @default(true)
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  vinculaciones      VinculacionCatedra[]
}

model Cargo {
  id                 String               @id @default(uuid())
  nombre             String               @unique
  activo             Boolean              @default(true)
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  vinculaciones      VinculacionCatedra[]
}

model Designacion {
  id                 String               @id @default(uuid())
  nombre             String               @unique
  activo             Boolean              @default(true)
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  vinculaciones      VinculacionCatedra[]
}

model Modalidad {
  id                 String               @id @default(uuid())
  nombre             String               @unique
  activo             Boolean              @default(true)
  fechaCreacion      DateTime             @default(now())
  fechaActualizacion DateTime             @updatedAt
  vinculaciones      VinculacionCatedra[]
}

model AreaDisciplinar {
  id                 String    @id @default(uuid())
  nombre             String    @unique
  activo             Boolean   @default(true)
  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt
  docentes           Docente[]
  subareas           Subarea[]
}

model Subarea {
  id                 String          @id @default(uuid())
  nombre             String
  areaDisciplinarId  String
  activo             Boolean         @default(true)
  fechaCreacion      DateTime        @default(now())
  fechaActualizacion DateTime        @updatedAt
  docentes           Docente[]
  areaDisciplinar    AreaDisciplinar @relation(fields: [areaDisciplinarId], references: [id])

  @@unique([nombre, areaDisciplinarId])
}

model Docente {
  id                                           String               @id @default(uuid())
  nombre                                       String
  apellido                                     String
  tipoDocumento                                String
  numeroDocumento                              String               @unique
  correoElectronico                            String               @unique
  tituloGrado                                  String?
  tituloPosgrado                               String?
  cargoDeclarado                               String?
  justificacionPertinencia                     String?
  actividadesProfesionales                     String?
  antecedentesAcademicos                       String?
  activo                                       Boolean              @default(true)
  fechaCreacion                                DateTime             @default(now())
  fechaActualizacion                           DateTime             @updatedAt
  usuarioId                                    String?              @unique
  codigoPostal                                 String?
  cuit                                         String?
  fechaNacimiento                              DateTime?
  localidad                                    String?
  pisoDepto                                    String?
  provincia                                    String?
  residencia                                   String?
  sexo                                         String?
  dedicacion                                   String?
  categoriaDocente                             String?
  dedicacionDeclaradaSemanal                   String?
  designacion                                  String?
  disciplinaCargo                              String?
  fechaFinCargo                                String?
  fechaInicioCargo                             String?
  tiempoDocencia                               String?
  tiempoExtension                              String?
  tiempoGestionAcademica                       String?
  tiempoInvestigacion                          String?
  unidadAcademica                              String?
  actividadesExtensionJson                     String?
  asignaturasVinculadas                        String?
  cargosAcademicosJson                         String?
  carreraAsociadaGestion                       String?
  categoriaPromocion                           String?
  disciplinasVinculadasProyectoInvestigacion   String?
  fechaAltaPromocion                           String?
  fechaFinGestion                              String?
  fechaFinProyectoInvestigacion                String?
  fechaInicioActividadExtension                String?
  fechaInicioGestion                           String?
  fechaInicioProyectoInvestigacion             String?
  finEstadoActividadExtension                  String?
  funcionGestion                               String?
  institucionDestinoActividadExtension         String?
  institucionEvaluadoraProyectoInvestigacion   String?
  institucionFinanciadoraProyectoInvestigacion String?
  institucionProyectoInvestigacion             String?
  normativaDesignacionGestion                  String?
  otrosTitulos                                 String?
  proyectosInvestigacionJson                   String?
  registrosPromocionJson                       String?
  rolActividadExtension                        String?
  sistemaPromocion                             String?
  tiempoDedicacionGestionSemanal               String?
  tituloActividadExtension                     String?
  tituloProyectoInvestigacion                  String?
  unidadAcademicaGestion                       String?
  vinculadaActividadExtension                  String?
  vinculadoCarreraProyectoInvestigacion        String?
  carreraFormacionDocenteJson                  String?
  areaDisciplinar                              String?
  observacionesArea                            String?
  subarea                                      String?
  actividadesPosgradoJson                      String?
  direccionTesisJson                           String?
  experienciaDistancia                         String?
  trayectoriaCargosPasadosJson                 String?
  otrasDedicacionesJson                        String?
  desempenoActualJson                          String?
  desempenoPasadoJson                          String?
  participacionVinculacionJson                 String?
  produccionCientificaJson                     String?
  sistemasPromocionInvestigacionJson           String?
  reunionesCientificasJson                     String?
  comitesJuradosJson                           String?
  actividadesTransferenciaExtension            String?
  carreraDocentePosgrado                       String?
  estanciasCursosExterior                      String?
  membresiasInstituciones                      String?
  premiosDistinciones                          String?
  areaDisciplinarId                            String?
  subareaId                                    String?
  areaDisciplinarRel                           AreaDisciplinar?     @relation(fields: [areaDisciplinarId], references: [id])
  subareaRel                                   Subarea?             @relation(fields: [subareaId], references: [id])
  usuario                                      Usuario?             @relation(fields: [usuarioId], references: [id])
  notificaciones                               Notificacion[]
  vinculaciones                                VinculacionCatedra[]
}

model VinculacionCatedra {
  id                          String      @id @default(uuid())
  facultadId                  String
  carreraId                   String
  planEstudioId               String
  materiaId                   String
  docenteId                   String
  catedraId                   String
  cargoId                     String
  modalidadId                 String
  designacionId               String
  estado                      String      @default("PENDIENTE_DE_APROBACION")
  observaciones               String?
  usuarioSolicitanteId        String
  fechaCreacion               DateTime    @default(now())
  fechaActualizacion          DateTime    @updatedAt
  aprobadorId                 String?
  fechaAprobacion             DateTime?
  motivoRechazo               String?
  horasSemana                 Int?
  anioInicio                  Int?
  desvinculadorId             String?
  fechaDesvinculacion         DateTime?
  motivoDesvinculacion        String?
  fechaRegistroDesvinculacion DateTime?
  aprobador                   Usuario?    @relation("VinculacionAprobador", fields: [aprobadorId], references: [id])
  cargo                       Cargo       @relation(fields: [cargoId], references: [id])
  carrera                     Carrera     @relation(fields: [carreraId], references: [id])
  catedra                     Catedra     @relation(fields: [catedraId], references: [id])
  designacion                 Designacion @relation(fields: [designacionId], references: [id])
  desvinculador               Usuario?    @relation("VinculacionDesvinculador", fields: [desvinculadorId], references: [id])
  docente                     Docente     @relation(fields: [docenteId], references: [id])
  facultad                    Facultad    @relation(fields: [facultadId], references: [id])
  materia                     Materia     @relation(fields: [materiaId], references: [id])
  modalidad                   Modalidad   @relation(fields: [modalidadId], references: [id])
  planEstudio                 PlanEstudio @relation(fields: [planEstudioId], references: [id])
  usuarioSolicitante          Usuario     @relation("VinculacionSolicitante", fields: [usuarioSolicitanteId], references: [id])
}

model TipoPosgrado {
  id                 String   @id @default(uuid())
  nombre             String   @unique
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
}

model TipoNormativa {
  id                 String      @id @default(uuid())
  nombre             String      @unique
  activo             Boolean     @default(true)
  fechaCreacion      DateTime    @default(now())
  fechaActualizacion DateTime    @updatedAt
  normativas         Normativa[]
}

model TipoAreaEmisora {
  id                 String   @id @default(uuid())
  nombre             String   @unique
  activo             Boolean  @default(true)
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
}

model Normativa {
  id                    String        @id @default(uuid())
  titulo                String
  fechaEmision          DateTime
  areaEmisora           String
  vigencia              String        @default("VIGENTE")
  numeroNorma           String
  anio                  Int
  palabrasClave         String?
  tipoNormativaId       String
  rutaArchivoOriginal   String?
  rutaArchivoCuarentena String?
  nombreArchivoOriginal String?
  nombreArchivoFisico   String?
  tamanioArchivo        Int?
  mimeType              String?
  eliminado             Boolean       @default(false)
  fechaEliminacion      DateTime?
  eliminadoPorUsuarioId String?
  motivoEliminacion     String?
  fechaCreacion         DateTime      @default(now())
  fechaActualizacion    DateTime      @updatedAt
  normativaSucesoraId   String?
  tipoNormativa         TipoNormativa  @relation(fields: [tipoNormativaId], references: [id])
  normativaSucesora     Normativa?     @relation("NormativaSucesora", fields: [normativaSucesoraId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  normativasReemplazadas Normativa[]   @relation("NormativaSucesora")
  historialEstados      HistorialEstadoNormativa[]

  @@unique([numeroNorma, anio])
}

model HistorialEstadoNormativa {
  id                  String   @id @default(uuid())
  normativaId         String
  estadoAnterior      String
  estadoNuevo         String
  motivo              String
  normativaSucesoraId String?
  usuarioId           String?
  fechaCambio         DateTime @default(now())
  normativa           Normativa @relation(fields: [normativaId], references: [id])
}

model Notificacion {
  id                   String    @id @default(uuid())
  tipo                 String
  titulo               String
  cuerpo               String
  leida                Boolean   @default(false)
  fechaLectura         DateTime?
  docenteId            String?
  usuarioId            String?
  vinculacionId        String?
  solicitudProgramaId  String?
  fechaCreacion        DateTime  @default(now())
  fechaActualizacion   DateTime  @updatedAt
  docente              Docente?  @relation(fields: [docenteId], references: [id])
  usuario              Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
}

model AuditLogNormativa {
  id               String   @id @default(uuid())
  fecha            DateTime @default(now())
  usuarioId        String?
  usuarioNombre    String?
  accion           String
  normativaId      String?
  normativaTitulo  String?
  normativaNumero  String?
  normativaAnio    Int?
  detalle          Json?
  ipOrigen         String?

  @@index([fecha])
  @@index([usuarioId])
  @@index([accion])
  @@index([normativaId])
}

// ── Scopes institucionales (FASE 1) ─────────────────────────────────────────
// SCOPE != PERMISO. La existencia de estas filas delimita el universo de
// Carreras/Facultades que el usuario puede gestionar, pero no concede
// permisos por sí sola. El RBAC del controlador valida la operación concreta.

model UsuarioCarrera {
  id                 String   @id @default(uuid())
  usuarioId          String
  carreraId          String
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  usuario            Usuario  @relation(fields: [usuarioId], references: [id])
  carrera            Carrera  @relation(fields: [carreraId], references: [id])

  @@unique([usuarioId, carreraId])
}

model UsuarioFacultad {
  id                 String   @id @default(uuid())
  usuarioId          String
  facultadId         String
  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
  usuario            Usuario  @relation(fields: [usuarioId], references: [id])
  facultad           Facultad @relation(fields: [facultadId], references: [id])

  @@unique([usuarioId, facultadId])
}

// ── Circuito de aprobación de Programas de Asignatura ───────────────────────
// estados: PENDIENTE_APROBACION | APROBADO | CORRECCIONES_SOLICITADAS | INVALIDADA
// Una solicitud PENDIENTE_APROBACION se genera automáticamente cuando el programa
// alcanza 100% de avance. Los roles aprobadores son los definidos en RBAC.

model SolicitudAprobacionPrograma {
  id              String                      @id @default(uuid())
  programaId      String
  estado          String                      @default("PENDIENTE_APROBACION")
  fechaCreacion   DateTime                    @default(now())
  fechaResolucion DateTime?
  aprobadorId     String?
  observaciones   String?
  programa        ProgramaAsignatura          @relation(fields: [programaId], references: [id], onDelete: Cascade)
  aprobador       Usuario?                    @relation("SolicitudProgramaAprobador", fields: [aprobadorId], references: [id])
  mensajes        MensajeCorrecionPrograma[]

  @@index([programaId, estado])
}

// ── Conversación DOCENTE ↔ DIRECTIVO sobre correcciones de Programas ─────────
// tipo: CORRECCION (enviado por directivo) | RESPUESTA (enviado por docente)
// leido: el destinatario del mensaje lo leyó:
//   CORRECCION → destinatario es el DOCENTE (leido=true cuando abre la conversación)
//   RESPUESTA  → destinatario es el DIRECTIVO

model MensajeCorrecionPrograma {
  id            String                      @id @default(uuid())
  solicitudId   String
  programaId    String
  usuarioId     String
  rolNombre     String
  contenido     String
  tipo          String
  leido         Boolean                     @default(false)
  fechaLectura  DateTime?
  fechaCreacion DateTime                    @default(now())
  solicitud     SolicitudAprobacionPrograma @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  programa      ProgramaAsignatura          @relation(fields: [programaId], references: [id], onDelete: Cascade)
  usuario       Usuario                     @relation(fields: [usuarioId], references: [id])

  @@index([solicitudId])
  @@index([programaId])
}
